# Copiar a .env y completar. El archivo .env no se sube al repositorio.

# Correo de la única cuenta DESARROLLADOR. Se crea sin contraseña al arrancar por primera vez;
# la contraseña se crea con "Olvidé mi contraseña".
Plataforma__CorreoDesarrollador=desarrollador@ejemplo.com

# Clave con la que se firman los tokens de sesión. Mínimo 32 caracteres. Cambiarla en cada entorno.
Sesion__ClaveFirma=cambiar-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas
Sesion__DiasVigencia=7

# Brevo. Con la llave vacía no se envían correos: se escriben en el registro de la API.
Brevo__Llave=
Brevo__Remitente=no-responder@ejemplo.com

# Dirección pública del frontend: se usa en los enlaces de los correos y en CORS.
Frontend__UrlBase=http://localhost:5173

BaseDatos__MigrarAlArrancar=true
ConnectionStrings__LFClub=Host=bd;Port=5432;Database=lfclub;Username=lfclub;Password=lfclub
