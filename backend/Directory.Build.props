<Project>

  <!-- Reglas comunes a todos los proyectos del backend. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Constitución §3: toda clase de src/ lleva documentación XML. Al generar el archivo de
    documentación, la falta de un comentario (CS1591) es un aviso y, por la regla anterior, un error.
    Los proyectos de pruebas quedan fuera.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('LFClub.Pruebas'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
